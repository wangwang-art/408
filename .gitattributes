# 统一换行：仓库内一律 LF
* text=auto eol=lf

# cmd.exe 解析 bat/cmd 依赖 CRLF：LF 行尾会在读取缓冲区边界把行从中间截断，
# 产生 "'ot' 不是内部或外部命令" 之类的碎片报错与闪退，故强制以 CRLF 检出
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制显式声明，避免换行转换与文本 diff
*.png    binary -diff
*.jpg    binary -diff
*.jpeg   binary -diff
*.gif    binary -diff
*.mp3    binary -diff
*.mp4    binary -diff
*.onnx   binary -diff
*.apk    binary -diff
*.bundle binary -diff
*.task   binary -diff
